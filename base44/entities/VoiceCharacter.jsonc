{
  "name": "VoiceCharacter",
  "type": "object",
  "properties": {
    "story_id": {
      "type": "string",
      "description": "ID of the story this character belongs to"
    },
    "name": {
      "type": "string",
      "description": "Character name"
    },
    "gender": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "narrator"
      ],
      "default": "male"
    },
    "voice_id": {
      "type": "string",
      "description": "ElevenLabs Voice ID (optional \u2014 set when voice cloning succeeds)"
    },
    "voice_name": {
      "type": "string",
      "description": "Display name of the voice"
    },
    "sample_audio_url": {
      "type": "string",
      "description": "Playable reference audio sample URL for this character"
    },
    "stability": {
      "type": "number",
      "default": 0.5,
      "description": "Voice stability 0-1"
    },
    "similarity_boost": {
      "type": "number",
      "default": 0.75,
      "description": "Similarity boost 0-1"
    },
    "style": {
      "type": "number",
      "default": 0.4,
      "description": "Style exaggeration 0-1"
    },
    "speed": {
      "type": "number",
      "default": 1.0,
      "description": "Speaking speed"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords to detect this character in text"
    },
    "author_email": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "gender"
  ]
}